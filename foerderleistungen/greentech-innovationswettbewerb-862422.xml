    <property name="gsb:bodyText" type="RichText">
        <text>&lt;![CDATA[&lt;div xmlns:xlink="http://www.w3.org/1999/xlink"&gt;&lt;h5&gt;Rechtsgrundlage&lt;/h5&gt;&lt;p&gt;GreenTech Innovationswettbewerb - Digitale Technologien als Hebel für die Kreislaufwirtschaft &lt;br /&gt;Förderaufruf auf Grundlage des Förderprogramms „Entwicklung digitaler Technologien“&lt;/p&gt;&lt;p&gt;Die Frist zur Einreichung von Skizzen endet am 24.03.2025 (12:00 Uhr).&lt;/p&gt;&lt;p&gt;&lt;a xlink:type="simple" xlink:actuate="onLoad" xlink:href="target:/BMWI/FDB/Content/DE/ExternerLink/R/rgl-greentech-innovationswettbewerb-862422" xlink:show="replace"&gt;Weblink zum Förderaufruf&lt;/a&gt;&lt;/p&gt;&lt;p&gt;Bekanntmachung Förderprogramm „Entwicklung digitaler Technologien“ (2022 bis 2026) vom 01.07.2022, zuletzt geändert durch die Änderung der Bekanntmachung Förderprogramm „Entwicklung digitaler Technologien“ (2022 bis 2026) vom 20.12.2023&lt;/p&gt;&lt;p&gt;&lt;a xlink:type="simple" xlink:actuate="onLoad" xlink:href="target:/BMWI/FDB/Content/DE/ExternerLink/R/rgl-greentech-innovationswettbewerb-862422-2" xlink:show="replace"&gt;Weblink zur Bekanntmachung&lt;/a&gt;&lt;/p&gt;&lt;p&gt;&lt;a xlink:type="simple" xlink:actuate="onLoad" xlink:href="target:/BMWI/FDB/Content/DE/ExternerLink/R/rgl-greentech-innovationswettbewerb-862422-3" xlink:show="replace"&gt;Weblink zur Bekanntmachung der Änderung&lt;/a&gt;&lt;/p&gt;&lt;/div&gt;]]&gt;</text>
    </property>
