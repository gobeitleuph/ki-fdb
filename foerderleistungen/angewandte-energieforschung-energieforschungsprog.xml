    </property>
    <property name="gsb:progress" type="RichText">
        <text>&lt;![CDATA[&lt;div xmlns:xlink="http://www.w3.org/1999/xlink"&gt;&lt;p&gt;Die Bearbeitungsdauer richtet sich nach der Art der Vorhaben. Mikroprojekte können innerhalb von zwei bis drei Monaten bearbeitet werden. Komplexe Verbundvorhaben benötigen erfahrungsgemäß sechs Monate und länger.&lt;/p&gt;&lt;/div&gt;]]&gt;</text>
